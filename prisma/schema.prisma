// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// url connects through Supabase's pgbouncer transaction pooler (port 6543)
// for normal app queries; directUrl bypasses the pooler (port 5432) for
// Prisma Migrate, which needs a real session for advisory locks that
// pgbouncer's transaction mode doesn't support.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Company {
  id        String     @id @default(cuid())
  name      String
  domain    String     @unique
  hrUsers   HRUser[]
  positions Position[]
}

model HRUser {
  id            String         @id @default(cuid())
  /// Linked Supabase Auth account. Unlike JobSeeker, a Google sign-in can only
  /// ever *attach to* an HR row that already exists — an HRUser must belong to
  /// a Company, and letting Google create one would mean any Google account
  /// could join a company by matching its email domain. See
  /// linkSupabaseUserToHRUser in src/lib/auth.ts.
  supabaseUserId String?       @unique
  name          String
  email         String         @unique
  /// Null for Google-only accounts. Existing values are plaintext — see the
  /// note on JobSeeker.password.
  password      String?
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id])
  notifications Notification[]
  revealEvents  RevealEvent[]
}

/// Recipient is exactly one of hrUserId/jobSeekerId — enforced at the
/// Server Action layer (see src/lib/actions/interview.ts), not a DB CHECK
/// constraint, consistent with this prototype's other soft-enforced rules.
/// HR-side notifications go to every HRUser at a company (Position has no
/// single "owner" HR account — companies staff positions as a team here).
model Notification {
  id          String     @id @default(cuid())
  hrUserId    String?
  hrUser      HRUser?    @relation(fields: [hrUserId], references: [id])
  jobSeekerId String?
  jobSeeker   JobSeeker? @relation(fields: [jobSeekerId], references: [id])
  type        String
  message     String
  linkUrl     String?
  isRead      Boolean    @default(false)
  createdAt   DateTime   @default(now())
}

model Position {
  id                 String        @id @default(cuid())
  companyId          String
  company            Company       @relation(fields: [companyId], references: [id])
  title              String
  requiredHardSkills String[]
  requiredSoftSkills Json
  status             String        @default("open")
  matches            Match[]
  revealEvents       RevealEvent[]
}

model Match {
  id            String         @id @default(cuid())
  positionId    String
  position      Position       @relation(fields: [positionId], references: [id])
  jobSeekerId   String
  jobSeeker     JobSeeker      @relation(fields: [jobSeekerId], references: [id])
  matchScore    Int
  isStandout    Boolean        @default(false)
  status        String         @default("pending")
  interviewSlot InterviewSlot?
}

model InterviewSlot {
  id            String   @id @default(cuid())
  matchId       String   @unique
  match         Match    @relation(fields: [matchId], references: [id])
  proposedTimes String[]
  status        String   @default("pending")
  confirmedTime String?
}

model JobSeeker {
  id                String             @id @default(cuid())
  /// The `auth.users.id` of the linked Supabase Auth account (Google sign-in).
  /// Null for the accounts that existed before Google sign-in was added, which
  /// still authenticate with the email/password pair below.
  ///
  /// This is what makes RLS possible: policies compare `auth.uid()` against
  /// this column, so Postgres itself can decide which rows a request may read
  /// instead of trusting the application to filter correctly every time.
  supabaseUserId    String?            @unique
  name              String
  email             String             @unique
  /// Profile picture from Google. Null for password accounts.
  avatarUrl         String?
  /// Null for Google-only accounts, which have no password to store.
  ///
  /// Prototype only — the values that ARE here are plaintext, no hashing.
  /// Never returned from a Server Action to the client (see SafeJobSeeker in
  /// src/lib/auth.ts). Needs real hashing (bcrypt/argon2) before production;
  /// Google sign-in reduces how many accounts depend on it but does not fix
  /// the ones that already exist.
  password          String?
  profile           JobSeekerProfile?
  chatVerifications ChatVerification[]
  gameResult        GameResult?
  aiSummary         AISummary?
  matches           Match[]
  notifications     Notification[]
  revealEvents      RevealEvent[]
  createdAt         DateTime           @default(now())
}

/// หลักฐานว่าแพลตฟอร์ม "ซ่อนตัวตนเพื่อลดอคติ" จริง ไม่ใช่แค่ซ่อนที่หน้าจอ
///
/// ด่านแรก HR เห็นเฉพาะทักษะกับผลประเมิน 6 มิติ — ชื่อจริง มหาวิทยาลัย เกรด
/// อายุ เพศ ถูกกันไว้ พอจำเป็นต้องเปิดดูจริง (เช่นนัดสัมภาษณ์) ต้องบันทึกไว้
/// ทุกครั้งว่า **ใครเปิดดูของใคร ตอนไหน และเพราะอะไร**
///
/// ทำไมต้องมีตารางนี้: คำเคลมเรื่องลดอคติที่ไม่มีหลักฐานตรวจสอบได้ ก็เป็นแค่
/// คำพูด ตารางนี้ทำให้เปิดให้กรรมการดูสดได้ว่ากดแล้วมัน log จริง และถ้าทำต่อ
/// เป็นผลิตภัณฑ์จริง มันคือสิ่งที่ผู้สมัครใช้ตรวจสอบได้ว่ามีใครดูข้อมูลตัวเองบ้าง
///
/// reason ตั้งใจให้เป็น String บังคับกรอก (ไม่ใช่ optional) — การบังคับให้พิมพ์
/// เหตุผลทำให้คนคิดก่อนกด ซึ่งได้ผลกว่าการเก็บ log เฉย ๆ
///
/// หมายเหตุ: การเขียน log ควรอยู่ในทรานแซกชันเดียวกับการอ่านข้อมูลตัวตน
/// (ดู src/lib/actions/ — ห้ามอ่านก่อนแล้วค่อย log ทีหลัง เพราะถ้า log พัง
/// จะกลายเป็นว่าดูข้อมูลไปแล้วโดยไม่มีร่องรอย)
model RevealEvent {
  id          String    @id @default(cuid())
  jobSeekerId String
  jobSeeker   JobSeeker @relation(fields: [jobSeekerId], references: [id])
  hrUserId    String
  hrUser      HRUser    @relation(fields: [hrUserId], references: [id])
  /// ตำแหน่งงานที่เป็นเหตุให้ต้องเปิดดู — ไม่บังคับ เพราะบางครั้งเปิดดูจาก
  /// หน้าโปรไฟล์ตรง ๆ ไม่ได้มาจากประกาศงานใดงานหนึ่ง
  positionId  String?
  position    Position? @relation(fields: [positionId], references: [id])
  reason      String
  revealedAt  DateTime  @default(now())

  @@index([jobSeekerId, revealedAt])
  @@index([hrUserId, revealedAt])
}

/// The candidate's structured profile, modeled on JobThai's own resume-form
/// sections — normalized (not one JSON blob) so a future resume-template
/// renderer can query/iterate each section directly instead of parsing an
/// opaque structure. Replaces the old ResumeExtraction model: computerSkills
/// and resumeRawText below are that model's hardSkills/rawText fields, now
/// living alongside the rest of the profile instead of split out on their
/// own — one source of truth for "does this candidate have any skills yet"
/// (the /decoder gate) regardless of whether they came from a parsed PDF or
/// the manual multi-step form.
model JobSeekerProfile {
  id          String    @id @default(cuid())
  jobSeekerId String    @unique
  jobSeeker   JobSeeker @relation(fields: [jobSeekerId], references: [id])

  // ข้อมูลส่วนบุคคล (personal information)
  firstNameTh    String?
  lastNameTh     String?
  firstNameEn    String?
  lastNameEn     String?
  birthDate      DateTime?
  gender         String?
  nationality    String?
  religion       String?
  maritalStatus  String?
  address        String?
  province       String?
  postalCode     String?
  phone          String?
  militaryStatus String?

  // ลักษณะงานที่ต้องการ (desired job)
  desiredPosition  String?
  desiredSalaryMin Int?
  desiredSalaryMax Int?
  desiredJobType   String?
  desiredProvince  String?
  availableDate    DateTime?

  education      EducationEntry[]
  workExperience WorkExperienceEntry[]
  languageSkills LanguageSkillEntry[]
  certificates   CertificateEntry[]

  /// Validated against the O*NET dictionary via the same SkillAutocomplete
  /// component Position's own hard-skills field uses.
  computerSkills String[]
  /// Parsed text of the most recently uploaded resume PDF, if any —
  /// defaults to "" for a candidate who only ever used the manual form.
  resumeRawText  String   @default("")

  updatedAt DateTime @updatedAt
}

model EducationEntry {
  id           String           @id @default(cuid())
  profileId    String
  profile      JobSeekerProfile @relation(fields: [profileId], references: [id])
  level        String
  institution  String
  fieldOfStudy String?
  gpa          Float?
  startYear    Int?
  endYear      Int?
  sortOrder    Int              @default(0)
}

model WorkExperienceEntry {
  id               String           @id @default(cuid())
  profileId        String
  profile          JobSeekerProfile @relation(fields: [profileId], references: [id])
  companyName      String
  jobTitle         String
  responsibilities String?
  salary           Int?
  startDate        DateTime?
  endDate          DateTime?
  isCurrent        Boolean          @default(false)
  sortOrder        Int              @default(0)
}

model LanguageSkillEntry {
  id        String           @id @default(cuid())
  profileId String
  profile   JobSeekerProfile @relation(fields: [profileId], references: [id])
  language  String
  speaking  String?
  reading   String?
  writing   String?
}

model CertificateEntry {
  id        String           @id @default(cuid())
  profileId String
  profile   JobSeekerProfile @relation(fields: [profileId], references: [id])
  title     String
  issuer    String?
  issueDate DateTime?
  fileUrl   String?
}

model ChatVerification {
  id              String    @id @default(cuid())
  jobSeekerId     String
  jobSeeker       JobSeeker @relation(fields: [jobSeekerId], references: [id])
  skill           String
  status          String
  conversationLog Json
  updatedAt       DateTime  @updatedAt
}

/// 6-axis taxonomy matches the psychometric games' radarProfile.axes output
/// 1:1 (see src/lib/data.ts SOFT_SKILL_AXIS_ORDER, the same taxonomy used for
/// Position.requiredSoftSkills) — overallIndex is a display-only average of
/// the 6 axes, not consumed by matching (src/lib/matching.ts).
model GameResult {
  id                          String    @id @default(cuid())
  jobSeekerId                 String    @unique
  jobSeeker                   JobSeeker @relation(fields: [jobSeekerId], references: [id])
  riskTolerance               Int
  learningAgility             Int
  criticalThinking            Int
  decisionMakingUnderPressure Int
  collaborationMindset        Int
  resilienceAndAdaptability   Int
  overallIndex                Int
  updatedAt                   DateTime  @updatedAt
}

model AISummary {
  id          String    @id @default(cuid())
  jobSeekerId String    @unique
  jobSeeker   JobSeeker @relation(fields: [jobSeekerId], references: [id])
  summaryText String
  generatedAt DateTime  @default(now())
  sourceHash  String
}
