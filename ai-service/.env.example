# ============================================================
# คนตรงปก — AI service config
# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ถูก gitignore ไว้)
# ============================================================

# ---------- ชั้น C: generative LLM (ปากที่คุยสัมภาษณ์) ----------
# เลือกได้ 3 ทาง: typhoon_api | ollama | hf_local
LLM_PROVIDER=hf_local

# --- ทาง 1: Typhoon API (แนะนำสำหรับ demo — เร็วสุด ไม่กิน RAM เครื่องเรา) ---
# ขอ key ฟรีที่ https://opentyphoon.ai
TYPHOON_API_KEY=
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct
# ทางเลือกที่เบากว่า/ถูกกว่า: typhoon-v2.1-12b-instruct

# --- ทาง 2: Ollama (สำหรับซ้อม demo ตอนเน็ตล่ม) ---
# ollama pull hf.co/scb10x/typhoon2.5-qwen3-4b-gguf
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=hf.co/scb10x/typhoon2.5-qwen3-4b-gguf

# --- ทาง 3: HuggingFace transformers ในเครื่อง (ต้องมี GPU) ---
HF_LOCAL_MODEL=scb10x/typhoon2.5-qwen3-4b
# โหลด 4-bit ให้พอดีกับการ์ดเล็ก (RTX 4050 6GB รันได้)
HF_LOAD_4BIT=true
# LoRA adapter ที่ fine-tune เอง — เว้นว่างไว้ = ใช้ base ล้วน
# ตั้งค่านี้ต่อเมื่อ eval_interview.py ยืนยันแล้วว่ามันชนะ base + prompt
HF_LORA_ADAPTER=C:\Users\User\generation_hack\ai-service\models\nong-trongpok-lora-pre-optimized-V2
# HF_LORA_ADAPTER=./models/nong-trongpok-lora

# ---------- ชั้น A: WangchanBERTa (สมองอ่านเรซูเม่) ----------
# ก่อน fine-tune เสร็จ ใช้ base model ไปก่อน (จะยังสกัดทักษะไม่ได้ แต่ระบบไม่พัง)
SKILL_MODEL_PATH=airesearch/wangchanberta-base-att-spm-uncased
# หลังเทรนเสร็จเปลี่ยนเป็น: ./models/skill-ner-v1
SKILL_MODEL_VERSION=base-untrained
SKILL_CONFIDENCE_THRESHOLD=0.60

# ---------- ฐานข้อมูล ----------
# ห้ามใส่ค่าจริงในไฟล์นี้ — .gitignore ตั้งใจ whitelist .env.example ไว้ให้ commit ได้
# เคยมีของจริงหลุดมาอยู่ตรงนี้แล้วครั้งหนึ่ง (รหัสผ่าน Supabase เต็ม ๆ)
# ค่าจริงใส่ใน .env เท่านั้น ซึ่งถูก .gitignore กันไว้ทุกแบบแล้ว
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---------- อื่น ๆ ----------
# โดเมนของ frontend ที่ให้เรียกได้
CORS_ORIGINS=http://localhost:5173,https://khontongpok.vercel.app
TESSERACT_CMD=
